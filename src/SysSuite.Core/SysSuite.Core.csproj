<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SysSuite.Core.Abstractions\SysSuite.Core.Abstractions.csproj" />
    <ProjectReference Include="..\SysSuite.Interop\SysSuite.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="System.Management" />
    <PackageReference Include="System.Drawing.Common" />
    <!-- T3.5 读 dism.exe 输出：OEM 代码页解码，见 Directory.Packages.props 的说明。 -->
    <PackageReference Include="System.Text.Encoding.CodePages" />
    <!-- T1.2 温度/风扇/电压传感器。HidSharp 是其运行时依赖（部分主板经 HID 上报）。 -->
    <PackageReference Include="LibreHardwareMonitorLib" />
    <PackageReference Include="HidSharp" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Data\known-software-profiles.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\rules\clean-temp.json" Link="rules\clean-temp.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SysSuite.Tests" />
  </ItemGroup>
</Project>