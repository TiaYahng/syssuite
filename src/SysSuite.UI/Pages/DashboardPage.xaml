<UserControl x:Class="SysSuite.UI.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="8,0,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="仪表盘" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource App.Text}" />
                    <TextBlock x:Name="StatusText" Text="正在获取系统状态..." Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource App.SubtleText}" />
                </StackPanel>
                <Button x:Name="NativeCheckButton" Grid.Column="1" Content="原生自检" Padding="12,4" Margin="12,0,0,0" VerticalAlignment="Center" Click="OnNativeCheckClick" />
            </Grid>
        </Border>

        <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" PanningMode="VerticalOnly" Focusable="False" PreviewMouseWheel="OnContentScrollPreviewMouseWheel">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="8" Padding="10">
                        <Grid>
                            <Ellipse Stroke="{DynamicResource App.Background}" StrokeThickness="6" Stretch="Uniform" />
                            <Ellipse x:Name="CpuArc" Stroke="{DynamicResource App.Accent}" StrokeThickness="6" Stretch="Uniform" StrokeDashArray="0 10" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-90" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="CpuPercentText" Text="0%" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource App.Text}" />
                                <TextBlock Text="CPU" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource App.SubtleText}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="8" Padding="10">
                        <Grid>
                            <Ellipse Stroke="{DynamicResource App.Background}" StrokeThickness="6" Stretch="Uniform" />
                            <Ellipse x:Name="MemoryArc" Stroke="{DynamicResource App.Accent}" StrokeThickness="6" Stretch="Uniform" StrokeDashArray="0 10" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-90" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="MemoryPercentText" Text="0%" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource App.Text}" />
                                <TextBlock Text="内存" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource App.SubtleText}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="4" Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="8" Padding="10">
                        <Grid>
                            <Ellipse Stroke="{DynamicResource App.Background}" StrokeThickness="6" Stretch="Uniform" />
                            <Ellipse x:Name="DiskArc" Stroke="{DynamicResource App.Accent}" StrokeThickness="6" Stretch="Uniform" StrokeDashArray="0 10" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-90" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="DiskPercentText" Text="0%" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource App.Text}" />
                                <TextBlock Text="磁盘" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource App.SubtleText}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="6" Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="8" Padding="10">
                        <Grid>
                            <Ellipse Stroke="{DynamicResource App.Background}" StrokeThickness="6" Stretch="Uniform" />
                            <Ellipse x:Name="NetworkArc" Stroke="{DynamicResource App.Accent}" StrokeThickness="6" Stretch="Uniform" StrokeDashArray="0 10" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-90" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="NetworkPercentText" Text="0%" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource App.Text}" />
                                <TextBlock Text="网络" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource App.SubtleText}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,4,4,4">
                    <StackPanel>
                        <TextBlock Text="系统摘要" FontWeight="SemiBold" Foreground="{DynamicResource App.Text}" />
                        <TextBlock x:Name="CpuSummaryText" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource App.Text}" />
                        <TextBlock x:Name="MemorySummaryText" Margin="0,2,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource App.Text}" />
                        <TextBlock x:Name="DiskSummaryText" Margin="0,2,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource App.Text}" />
                        <TextBlock x:Name="GpuSummaryText" Margin="0,2,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource App.Text}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="4,4,0,4">
                    <StackPanel>
                        <TextBlock Text="实时活动" FontWeight="SemiBold" Foreground="{DynamicResource App.Text}" />
                        <Grid Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Background="{DynamicResource App.Background}" CornerRadius="6" Padding="6" Margin="0,0,3,3">
                                <StackPanel>
                                    <TextBlock Text="磁盘读" FontSize="10" Foreground="{DynamicResource App.SubtleText}" />
                                    <TextBlock x:Name="DiskReadText" Margin="0,1,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource App.Text}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{DynamicResource App.Background}" CornerRadius="6" Padding="6" Margin="3,0,0,3">
                                <StackPanel>
                                    <TextBlock Text="磁盘写" FontSize="10" Foreground="{DynamicResource App.SubtleText}" />
                                    <TextBlock x:Name="DiskWriteText" Margin="0,1,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource App.Text}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource App.Background}" CornerRadius="6" Padding="6" Margin="0,3,0,0">
                                <StackPanel>
                                    <TextBlock Text="网络 收 / 发" FontSize="10" Foreground="{DynamicResource App.SubtleText}" />
                                    <TextBlock x:Name="NetworkText" Margin="0,1,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource App.Text}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
