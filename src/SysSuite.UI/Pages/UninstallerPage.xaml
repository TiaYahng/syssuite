<UserControl x:Class="SysSuite.UI.Pages.UninstallerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="14,12,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0" Padding="8,6" Background="{DynamicResource App.Surface}"
                BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" MaxWidth="360" HorizontalAlignment="Left">
                    <TextBox x:Name="SearchBox" Height="30" Padding="28,4,30,4" VerticalContentAlignment="Center"
                             TextChanged="OnSearchTextChanged" />
                    <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" Text="&#xE721;"
                               Foreground="{DynamicResource App.SubtleText}" IsHitTestVisible="False" />
                    <TextBlock Margin="28,0,0,0" VerticalAlignment="Center" Text="搜索程序 / 发布者 / 版本"
                               Foreground="{DynamicResource App.SubtleText}" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button x:Name="ClearSearchButton" Width="20" Height="20" Margin="0,0,4,0" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Padding="0"
                            Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Foreground="{DynamicResource App.SubtleText}" ToolTip="清除搜索"
                            Click="OnClearSearchClick" Visibility="Collapsed" />
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UninstallButton" Content="卸载" MinWidth="86" Height="30" Margin="0,0,8,0" Padding="10,2"
                            FontWeight="SemiBold" Background="{DynamicResource App.Safe}" BorderThickness="0"
                            Foreground="{DynamicResource App.AccentText}" ToolTip="静默卸载所选应用"
                            IsEnabled="False" Click="OnUninstallClick" />
                    <Button x:Name="ForceButton" Content="强制删除" MinWidth="86" Height="30" Margin="0,0,8,0"
                            ToolTip="删除所选应用的安装目录（需在设置中开启）" IsEnabled="False" Click="OnForceClick" />
                    <Button x:Name="RefreshButton" Content="刷新" MinWidth="64" Height="30" Margin="0,0,8,0"
                            ToolTip="重新枚举注册表、MSI 与 Store 应用" Click="OnRefreshClick" />
                    <Button x:Name="MonitorButton" Content="启动监控" MinWidth="88" Height="30" ToolTip="监听应用安装与卸载变化"
                            Click="OnMonitorClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}"
                BorderThickness="1" CornerRadius="6">
            <Grid>
                <ListView x:Name="AppsList" Margin="4" SelectionMode="Single"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          MouseDoubleClick="OnAppsListDoubleClick"
                          SelectionChanged="OnAppsListSelectionChanged">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="卸载" Click="OnUninstallClick" />
                            <MenuItem Header="强制删除" Click="OnForceClick" />
                            <Separator />
                            <MenuItem Header="打开安装目录" Click="OnOpenInstallFolderClick" />
                            <MenuItem Header="复制注册表路径" Click="OnCopyRegistryPathClick" />
                            <MenuItem Header="复制详情" Click="OnCopyDetailsClick" />
                            <MenuItem Header="在线搜索" Click="OnOpenOnlineSearchClick" />
                            <MenuItem Header="导出 HTML 报告" Click="OnExportHtmlClick" />
                            <Separator />
                            <MenuItem Header="刷新" Click="OnRefreshClick" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView AllowsColumnReorder="True">
                            <GridViewColumn Width="380">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="程序" Tag="Name" Click="OnColumnHeaderClick" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3"
                                                    AutomationProperties.Name="{Binding AutomationText}">
                                            <Grid Width="22" Height="22">
                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource App.SubtleText}" />
                                                <Image Source="{Binding Icon}" Width="18" Height="18"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="{Binding Name}" Margin="9,0,0,0" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" FontWeight="Medium" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="180" DisplayMemberBinding="{Binding Publisher}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="发布者" Tag="Publisher" Click="OnColumnHeaderClick" />
                                </GridViewColumn.Header>
                            </GridViewColumn>
                            <GridViewColumn Width="120" DisplayMemberBinding="{Binding InstalledOn}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="安装日期" Tag="InstalledOn" Click="OnColumnHeaderClick" />
                                </GridViewColumn.Header>
                            </GridViewColumn>
                            <GridViewColumn Width="100" DisplayMemberBinding="{Binding SizeText}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="大小" Tag="SizeText" Click="OnColumnHeaderClick" />
                                </GridViewColumn.Header>
                            </GridViewColumn>
                            <GridViewColumn Width="130" DisplayMemberBinding="{Binding Version}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="版本" Tag="Version" Click="OnColumnHeaderClick" />
                                </GridViewColumn.Header>
                            </GridViewColumn>
                            <GridViewColumn Width="90" DisplayMemberBinding="{Binding SourceLabel}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="来源" Tag="SourceLabel" Click="OnColumnHeaderClick" />
                                </GridViewColumn.Header>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="没有找到匹配的程序" Foreground="{DynamicResource App.SubtleText}" Visibility="Collapsed" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="2,8,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CountText" Grid.Column="0" VerticalAlignment="Center" Text="0 个程序"
                       Foreground="{DynamicResource App.SubtleText}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <ProgressBar x:Name="OperationProgress" Width="120" Height="4" VerticalAlignment="Center"
                             IsIndeterminate="True" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" Margin="10,0,0,0" VerticalAlignment="Center" Text="就绪"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource App.SubtleText}" />
            </StackPanel>
            <TextBlock x:Name="MonitorBadge" Grid.Column="2" VerticalAlignment="Center" Padding="10,3"
                       Background="{DynamicResource App.Hover}" Text="监控：关闭"
                       Foreground="{DynamicResource App.Text}" />
        </Grid>
    </Grid>
</UserControl>
