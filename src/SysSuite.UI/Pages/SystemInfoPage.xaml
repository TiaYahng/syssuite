<UserControl x:Class="SysSuite.UI.Pages.SystemInfoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="8,0,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="系统信息" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource App.Text}" />
                    <TextBlock x:Name="StatusText" Text="点击刷新获取硬件信息。" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource App.SubtleText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="刷新" Width="56" Height="26" Margin="0,0,6,0" FontSize="12" Padding="0" Background="{DynamicResource App.Accent}" Foreground="{DynamicResource App.AccentText}" Click="OnRefreshClick" />
                    <Button Content="导出报告" Width="72" Height="26" Margin="0,0,6,0" FontSize="12" Padding="0" Background="{DynamicResource App.Background}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" Foreground="{DynamicResource App.Text}" Click="OnExportReportClick" />
                    <Button Content="环境变量" Width="72" Height="26" FontSize="12" Padding="0" Background="{DynamicResource App.Background}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" Foreground="{DynamicResource App.Text}" Click="OnOpenEnvironmentVariablesClick" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" PanningMode="VerticalOnly" Focusable="False" PreviewMouseWheel="OnContentScrollPreviewMouseWheel">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" VerticalAlignment="Top" Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,4,4">
                    <StackPanel>
                        <TextBlock Text="核心硬件" FontWeight="SemiBold" Foreground="{DynamicResource App.Text}" />
                        <TextBlock x:Name="CpuText" Margin="0,3,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource App.Text}" />
                        <TextBlock x:Name="MotherboardText" Margin="0,2,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource App.Text}" />
                        <TextBlock x:Name="BiosText" Margin="0,2,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource App.Text}" />
                        <TextBlock x:Name="MemoryText" Margin="0,2,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource App.Text}" />
                        <TextBlock x:Name="OsText" Margin="0,2,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource App.Text}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" VerticalAlignment="Top" Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="4,0,0,4">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="实时监控" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource App.Text}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="PauseResumeButton" Content="暂停" Width="48" Height="20" Margin="0,0,4,0" FontSize="11" Padding="0" Background="{DynamicResource App.Background}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" Foreground="{DynamicResource App.Text}" Click="OnPauseResumeClick" />
                                <Button x:Name="WindowOneMinuteButton" Content="1 分钟" Width="54" Height="20" Margin="0,0,4,0" FontSize="11" Padding="0" Background="{DynamicResource App.Accent}" Foreground="{DynamicResource App.AccentText}" Click="OnWindowOneMinuteClick" />
                                <Button x:Name="WindowFiveMinuteButton" Content="5 分钟" Width="54" Height="20" FontSize="11" Padding="0" Background="{DynamicResource App.Background}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" Foreground="{DynamicResource App.Text}" Click="OnWindowFiveMinutesClick" />
                            </StackPanel>
                        </Grid>
                        <UniformGrid Columns="3" Margin="0,3,0,0">
                            <Border Background="{DynamicResource App.Background}" CornerRadius="6" Padding="4" Margin="0,0,2,2">
                                <StackPanel>
                                    <TextBlock Text="CPU" FontSize="10" Foreground="{DynamicResource App.SubtleText}" />
                                    <TextBlock x:Name="CpuUsageText" Margin="0,1,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource App.Text}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource App.Background}" CornerRadius="6" Padding="4" Margin="0,0,2,2">
                                <StackPanel>
                                    <TextBlock Text="内存" FontSize="10" Foreground="{DynamicResource App.SubtleText}" />
                                    <TextBlock x:Name="MemoryUsageText" Margin="0,1,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource App.Text}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource App.Background}" CornerRadius="6" Padding="4" Margin="0,0,0,2">
                                <StackPanel>
                                    <TextBlock Text="磁盘读取" FontSize="10" Foreground="{DynamicResource App.SubtleText}" />
                                    <TextBlock x:Name="DiskReadText" Margin="0,1,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource App.Text}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource App.Background}" CornerRadius="6" Padding="4" Margin="0,2,2,0">
                                <StackPanel>
                                    <TextBlock Text="磁盘写入" FontSize="10" Foreground="{DynamicResource App.SubtleText}" />
                                    <TextBlock x:Name="DiskWriteText" Margin="0,1,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource App.Text}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.ColumnSpan="2" Background="{DynamicResource App.Background}" CornerRadius="6" Padding="4" Margin="0,2,0,0">
                                <StackPanel>
                                    <TextBlock Text="网络 收 / 发" FontSize="10" Foreground="{DynamicResource App.SubtleText}" />
                                    <TextBlock x:Name="NetworkText" Margin="0,1,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource App.Text}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="温度" FontSize="10" Foreground="{DynamicResource App.SubtleText}" VerticalAlignment="Center" />
                            <TextBlock x:Name="SensorStatusText" Grid.Column="1" FontSize="10" Foreground="{DynamicResource App.SubtleText}" VerticalAlignment="Center" />
                        </Grid>
                        <UniformGrid Columns="2" Margin="0,2,0,0">
                            <Border Background="{DynamicResource App.Background}" CornerRadius="6" Padding="4" Margin="0,0,2,0">
                                <StackPanel>
                                    <TextBlock Text="CPU 温度" FontSize="10" Foreground="{DynamicResource App.SubtleText}" />
                                    <TextBlock x:Name="CpuTemperatureText" Margin="0,1,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource App.Text}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource App.Background}" CornerRadius="6" Padding="4" Margin="2,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="GPU 温度" FontSize="10" Foreground="{DynamicResource App.SubtleText}" />
                                    <TextBlock x:Name="GpuTemperatureText" Margin="0,1,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource App.Text}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <TextBlock x:Name="SensorHintText" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Foreground="{DynamicResource App.CautionText}" Visibility="Collapsed" />

                        <TextBlock Text="趋势" FontSize="10" Margin="0,4,0,0" Foreground="{DynamicResource App.SubtleText}" />
                        <Canvas x:Name="TrendCanvas" Height="92" Margin="0,2,0,0" Background="{DynamicResource App.Background}" ClipToBounds="True" SizeChanged="OnTrendCanvasSizeChanged" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,4,4">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="存储设备" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource App.Text}" />
                            <Button x:Name="DriveHealthButton" Grid.Column="1" Content="读取健康" Width="66" Height="20" FontSize="11" Padding="0" Background="{DynamicResource App.Background}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" Foreground="{DynamicResource App.Text}" Click="OnQueryDriveHealthClick" />
                        </Grid>
                        <TextBlock x:Name="DriveHealthHintText" Margin="0,3,0,0" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{DynamicResource App.SubtleText}" />
                        <Button x:Name="DriveHealthElevateButton" Content="以管理员身份重启并读取" HorizontalAlignment="Left" Margin="0,4,0,0" Height="22" FontSize="11" Padding="8,0" Visibility="Collapsed" Background="{DynamicResource App.Accent}" Foreground="{DynamicResource App.AccentText}" Click="OnElevateForDriveHealthClick" />

                        <ItemsControl x:Name="DriveHealthList" Margin="0,3,0,0" Visibility="Collapsed">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource App.Background}" CornerRadius="6" Padding="6,4" Margin="0,0,4,4" MinWidth="150">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource App.Text}" />
                                                <Border Grid.Column="1" Background="{Binding BadgeBackground}" CornerRadius="4" Padding="5,1" Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding LevelText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding BadgeForeground}" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding DetailText}" Margin="0,3,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource App.SubtleText}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ListView x:Name="StorageList" Margin="0,4,0,0" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.Resources>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="22" />
                                </Style>
                            </ListView.Resources>
                        </ListView>
                        <TextBlock Text="盘符使用情况" Margin="0,3,0,0" FontWeight="SemiBold" Foreground="{DynamicResource App.Text}" />
                        <ListView x:Name="DriveList" Margin="0,3,0,0" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.Resources>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="22" />
                                </Style>
                            </ListView.Resources>
                            <ListView.View>
                                <GridView>
                                    <GridView.ColumnHeaderContainerStyle>
                                        <Style TargetType="GridViewColumnHeader">
                                            <Setter Property="Padding" Value="4,1" />
                                            <Setter Property="MinHeight" Value="22" />
                                            <Setter Property="Margin" Value="0" />
                                        </Style>
                                    </GridView.ColumnHeaderContainerStyle>
                                    <GridViewColumn Header="盘符" DisplayMemberBinding="{Binding DriveLetter}" Width="50" />
                                    <GridViewColumn Header="卷标" DisplayMemberBinding="{Binding Label}" Width="120" />
                                    <GridViewColumn Header="总容量" DisplayMemberBinding="{Binding TotalText}" Width="82" />
                                    <GridViewColumn Header="已用" DisplayMemberBinding="{Binding UsedText}" Width="90" />
                                    <GridViewColumn Header="使用率" DisplayMemberBinding="{Binding UsageText}" Width="66" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="4,0,0,4">
                    <StackPanel>
                        <TextBlock Text="显卡信息" FontWeight="SemiBold" Foreground="{DynamicResource App.Text}" />
                        <ListView x:Name="GraphicsList" Margin="0,4,0,0" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.Resources>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,3" />
                                    <Setter Property="MinHeight" Value="20" />
                                </Style>
                            </ListView.Resources>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource App.Text}" />
                                        <ItemsControl ItemsSource="{Binding Details}" Margin="0,3,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border MaxWidth="430" Background="{DynamicResource App.Background}" CornerRadius="4" Padding="5,2" Margin="0,0,4,3">
                                                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource App.SubtleText}">
                                                            <Run Text="{Binding Label}" FontWeight="SemiBold" />
                                                            <Run Text="：" />
                                                            <Run Text="{Binding Value}" />
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0">
                    <StackPanel>
                        <TextBlock Text="网络适配器" FontWeight="SemiBold" Foreground="{DynamicResource App.Text}" />
                        <ListView x:Name="NetworkList" Margin="0,4,0,0" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.Resources>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="22" />
                                </Style>
                            </ListView.Resources>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
