<UserControl x:Class="SysSuite.UI.Pages.DiskCleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12,8,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="10" Padding="12,6" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="磁盘清理" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource App.Text}" />
                    <TextBlock x:Name="StatusText" Text="选择磁盘后一次性扫描临时文件、重复文件和空文件夹。" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource App.SubtleText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SelectAllButton" Width="64" Height="28" Margin="0,0,8,0" Click="OnSelectAllClick" IsEnabled="False">全选</Button>
                    <Button x:Name="CleanButton" Width="82" Height="28" Margin="0,0,8,0" Background="{DynamicResource App.Accent}" Foreground="{DynamicResource App.AccentText}" BorderThickness="0" Click="OnCleanClick" IsEnabled="False">清理选中</Button>
                    <Button x:Name="RestoreButton" Width="82" Height="28" Margin="0,0,8,0" Click="OnRestoreClick">撤销上次</Button>
                    <Button x:Name="ScanButton" Width="64" Height="28" Background="{DynamicResource App.Accent}" Foreground="{DynamicResource App.AccentText}" BorderThickness="0" Click="OnScanClick" IsDefault="True">扫描</Button>
                    <Button x:Name="CancelScanButton" Width="64" Height="28" Margin="8,0,0,0" Click="OnCancelScanClick" Visibility="Collapsed">取消</Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="10" Padding="10,5" Margin="0,0,0,6">
            <ItemsControl x:Name="DriveList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource App.Background}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="7" Padding="6,3" Margin="0,0,8,4">
                            <CheckBox Content="{Binding Title}" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,0,0,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ProgressPhaseText" Text="准备扫描" FontWeight="SemiBold" Foreground="{DynamicResource App.Text}" />
                    <TextBlock x:Name="ProgressDetailText" Grid.Column="2" Text="等待开始" FontSize="12" Foreground="{DynamicResource App.SubtleText}" />
                </Grid>
                <ProgressBar x:Name="ScanProgress" Grid.Row="1" Height="5" Margin="0,6,0,0" Minimum="0" Maximum="100" Background="{DynamicResource App.Background}" Foreground="{DynamicResource App.Accent}" BorderThickness="0" />
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="10" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="分类摘要" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource App.Text}" />
                    <ListBox x:Name="CategoryList" Grid.Row="1" Margin="0,8,0,0" Background="Transparent" BorderThickness="0" Padding="0" SelectionChanged="OnCategorySelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource App.Background}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="8" Padding="9,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource App.Text}" />
                                        <TextBlock Text="{Binding Summary}" Margin="0,2,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource App.SubtleText}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="10" Padding="12">
                <ListBox x:Name="ItemList" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource App.Background}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding GroupTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource App.Text}" />
                                                <TextBlock Text="{Binding RiskTitle}" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource App.SubtleText}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RiskName}" Value="Safe"><Setter Property="Foreground" Value="{DynamicResource App.SafeText}" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding RiskName}" Value="Caution"><Setter Property="Foreground" Value="{DynamicResource App.CautionText}" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding RiskName}" Value="Risky"><Setter Property="Foreground" Value="{DynamicResource App.RiskyText}" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontWeight="SemiBold" Foreground="{DynamicResource App.Text}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Path}" Margin="0,4,0,0" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource App.SubtleText}" />
                                        <TextBlock Text="{Binding Importance}" Margin="0,3,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource App.SubtleText}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="{Binding DriveBadge}" Tag="{Binding}" Width="42" Height="25" Padding="0" VerticalAlignment="Center" Click="OnOpenPathClick" ToolTip="{Binding Path}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
    </Grid>
</UserControl>
