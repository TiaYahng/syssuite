<UserControl x:Class="SysSuite.UI.Pages.CleanerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource App.Surface}" BorderBrush="{StaticResource App.Border}" BorderThickness="1" CornerRadius="8" Padding="24" Width="720">
        <StackPanel>
            <TextBlock Text="磁盘清理" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource App.Text}" />
            <TextBlock Text="临时文件、缓存与大文件。" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource App.SubtleText}" />
            <TextBlock Text="MVP0 骨架" Margin="0,16,0,0" Foreground="{StaticResource App.SubtleText}" />
        </StackPanel>
    </Border>
</UserControl>
