<Window x:Class="SysSuite.UI.CrashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SysSuite 崩溃"
        Width="720"
        Height="480"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="程序遇到未处理异常，可查看诊断信息后继续。" TextWrapping="Wrap" FontWeight="SemiBold" />
        <TextBox x:Name="ExceptionTextBox" Grid.Row="1" Margin="0,12" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Content="打开日志" Margin="0,0,8,0" Padding="12,6" Click="OnOpenLogs" />
            <Button Content="打开崩溃目录" Margin="0,0,8,0" Padding="12,6" Click="OnOpenCrashDirectory" />
            <Button Content="导出诊断" Margin="0,0,8,0" Padding="12,6" Click="OnExport" />
            <Button Content="继续" IsDefault="True" Padding="12,6" Click="OnContinue" />
        </StackPanel>
    </Grid>
</Window>
