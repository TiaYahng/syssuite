<Window x:Class="SysSuite.UI.Controls.LeftoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="900" Height="620" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource App.Background}">
    <Border Padding="24" Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="8" Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock Text="残留确认" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource App.Text}" />
                <TextBlock x:Name="StatusText" Text="" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource App.SubtleText}" />
            </StackPanel>
            <ListView x:Name="ItemsList" Grid.Row="1" MinHeight="120" Margin="0,18,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10,8" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding Selected, Mode=TwoWay}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" FontWeight="Medium" />
                                    <TextBlock Text="{Binding Reason}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Foreground="{DynamicResource App.SubtleText}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding KindLabel}" Foreground="{DynamicResource App.SubtleText}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="关闭" MinWidth="92" Margin="0,0,12,0" IsCancel="True" />
                <Button x:Name="DeleteButton" Content="删除选中项" MinWidth="126" Click="OnDeleteClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
