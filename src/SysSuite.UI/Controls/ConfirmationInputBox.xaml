<Window x:Class="SysSuite.UI.Controls.ConfirmationInputBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="620" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False" Background="{DynamicResource App.Background}">
    <Border Padding="24" Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="8" Margin="16">
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="高风险操作" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource App.Text}" />
            <TextBlock x:Name="MessageText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource App.SubtleText}" />
            <TextBox x:Name="InputBox" Margin="0,16,0,0" Padding="8" />
            <TextBlock x:Name="RequirementText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource App.SubtleText}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelButton" Content="取消" MinWidth="92" Margin="0,0,12,0" IsCancel="True" />
                <Button x:Name="ConfirmButton" Content="确认执行" MinWidth="112" IsDefault="True" Click="OnConfirmClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
