<Window x:Class="SysSuite.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SysSuite" Height="660" Width="920" MinHeight="600" MinWidth="760"
        Icon="Assets/App.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" SourceInitialized="OnSourceInitialized"
        Background="{DynamicResource App.Background}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonRoot" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Background" Value="{DynamicResource App.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Background" Value="{DynamicResource App.Border}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LayoutModeButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonRoot" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Background" Value="{DynamicResource App.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Background" Value="{DynamicResource App.Border}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource App.Background}" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel WindowChrome.IsHitTestVisibleInChrome="True" Orientation="Horizontal" Margin="12,0">
                    <TextBlock Text="SysSuite" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource App.Text}" />
                    <TextBlock x:Name="VersionText" Text="v1.0.0 beta" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource App.SubtleText}" />
                    <Button x:Name="LayoutButton" Style="{StaticResource LayoutModeButton}" Width="30" Height="28" Margin="6,0,0,0" Click="OnLayoutButtonClick" ToolTip="切换布局" AutomationProperties.Name="切换布局" />
                </StackPanel>
                <Border WindowChrome.IsHitTestVisibleInChrome="True" HorizontalAlignment="Center" Width="240" Height="24" Background="{DynamicResource App.Background}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <TextBox x:Name="SearchBox" Margin="8,0" VerticalAlignment="Center" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource App.Text}" />
                        <TextBlock Text="Ctrl+K" HorizontalAlignment="Right" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource App.SubtleText}" />
                    </Grid>
                </Border>
                <StackPanel WindowChrome.IsHitTestVisibleInChrome="True" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,0,12,0">
                    <Button Style="{StaticResource TitleBarButton}" Width="32" Height="28" Click="OnAccountClick" ToolTip="登录" AutomationProperties.Name="登录"><TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" FontWeight="Normal" Foreground="{DynamicResource App.Text}" /></Button>
                    <Button Style="{StaticResource TitleBarButton}" Width="32" Height="28" Click="OnThemeClick" ToolTip="切换主题" AutomationProperties.Name="切换主题"><TextBlock Text="&#xE793;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" FontWeight="Normal" Foreground="{DynamicResource App.Text}" /></Button>
                    <Button Style="{StaticResource TitleBarButton}" Width="32" Height="28" Click="OnSettingsClick" ToolTip="设置" AutomationProperties.Name="设置"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" FontWeight="Normal" Foreground="{DynamicResource App.Text}" /></Button>
                    <Button Style="{StaticResource TitleBarButton}" Width="36" Height="28" Click="OnMinimize" ToolTip="最小化" AutomationProperties.Name="最小化"><TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" FontWeight="Normal" Foreground="{DynamicResource App.Text}" /></Button>
                    <Button Style="{StaticResource TitleBarButton}" Width="36" Height="28" Click="OnMaximize" ToolTip="最大化" AutomationProperties.Name="最大化"><TextBlock x:Name="MaximizeIcon" Text="&#xE922;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" FontWeight="Normal" Foreground="{DynamicResource App.Text}" /></Button>
                    <Button Style="{StaticResource TitleBarButton}" Width="36" Height="28" Click="OnClose" ToolTip="关闭" AutomationProperties.Name="关闭"><TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" FontWeight="Normal" Foreground="{DynamicResource App.Text}" /></Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="RibbonContainer" Grid.Row="1" Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="RibbonPanel" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0" />
        </ScrollViewer>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftSidebarColumn" Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightSidebarColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Border x:Name="SidebarHost" Grid.Column="0" Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,1,0" PreviewMouseLeftButtonDown="OnSidebarPreviewMouseDown">
                <StackPanel x:Name="SidebarPanel" Margin="8" />
            </Border>
            <ContentControl x:Name="PageHost" Grid.Column="1" Margin="16,4,16,12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>

    </Grid>
</Window>
