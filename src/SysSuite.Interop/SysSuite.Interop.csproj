<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- P/Invoke 缓冲区与函数指针互操作需要 unsafe 上下文 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!--
      原生 DLL 自动构建（D12）。

      默认开启：clone 后直接 `dotnet build` 就能拿到 SysSuite.Native.dll，
      FFI 冒烟测试不会再因为缺 DLL 而自动 Skip（那等于静默零覆盖）。

      关掉的两种情形：
        1. `dotnet build -p:BuildNativeModule=false` —— 只想编译托管代码时；
        2. 环境变量 SYSSUITE_SKIP_NATIVE=1 —— CI 里已有独立的「构建并部署原生模块」
           步骤，重复构建纯属浪费（见 .github/workflows/ci.yml）。

      脚本失败时**不让整个构建失败**：原生模块缺失时 SysSuite.Interop 会优雅降级为
      `LibraryNotLoaded`（不抛异常），这是设计好的行为。所以缺 C++ 工具链的机器
      仍应能编译托管部分，失败降级为警告。
    -->
    <BuildNativeModule Condition="'$(BuildNativeModule)' == ''">true</BuildNativeModule>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SysSuite.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 便于开发期定位原生源码；不参与编译 -->
    <None Include="..\SysSuite.Native\include\native_api.h" Link="native\native_api.h" />
    <None Include="..\SysSuite.Native\CMakeLists.txt" Link="native\CMakeLists.txt" />
  </ItemGroup>

  <!--
    在托管编译完成后调用 rules/Build-Native.ps1 并把 DLL 部署到本项目输出目录。
    挂在 Build 之后（而非 _CopyFilesToOutputDirectory 之前）—— 后者在部分 SDK 版本里
    不构成有效的挂载点，目标会被静默跳过。
  -->
  <Target Name="BuildNativeModule"
          Condition="'$(BuildNativeModule)' == 'true' AND '$(OS)' == 'Windows_NT' AND '$(SYSSUITE_SKIP_NATIVE)' != '1' AND '$(DesignTimeBuild)' != 'true'"
          AfterTargets="Build">
    <PropertyGroup>
      <!-- Debug/Release 直接映射；原生构建脚本只认这两个值 -->
      <_NativeConfig Condition="'$(Configuration)' == 'Debug'">Debug</_NativeConfig>
      <_NativeConfig Condition="'$(Configuration)' != 'Debug'">Release</_NativeConfig>
      <!--
        路径必须归一化，否则 PowerShell 的 -File 会因路径中间含 `..` 而报退出码 64（参数解析失败）。
        注意 `$(MSBuildThisFileDirectory)` 以反斜杠**结尾**（形如 `...\src\SysSuite.Interop\`），
        所以从这里上溯两级即仓库根：`..\..\rules\Build-Native.ps1`。
      -->
      <_NativeScript>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\rules\Build-Native.ps1'))</_NativeScript>
      <_NativeDll>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\artifacts\native\$(_NativeConfig)\SysSuite.Native.dll'))</_NativeDll>
    </PropertyGroup>

    <Message Importance="high" Text="[interop] 构建原生模块 ($(_NativeConfig))..." />

    <!-- ContinueOnError=WarnAndContinue：缺 C++ 工具链时只警告，不中断托管构建 -->
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(_NativeScript)&quot; -Configuration $(_NativeConfig)"
          ContinueOnError="WarnAndContinue"
          Timeout="300000" />

    <Warning Condition="!Exists('$(_NativeDll)')"
             Text="[interop] 未找到 SysSuite.Native.dll，FFI 冒烟测试将自动跳过（静默零覆盖）。请检查 MSVC 工具链，或显式运行 rules/Build-Native.ps1。" />

    <Copy Condition="Exists('$(_NativeDll)')"
          SourceFiles="$(_NativeDll)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
    <Copy Condition="Exists('$(_NativeDll)')"
          SourceFiles="$(_NativeDll)"
          DestinationFolder="$(OutDir)runtimes\win-x64\native"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
