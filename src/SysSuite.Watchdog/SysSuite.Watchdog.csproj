<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <UserSecretsId>dotnet-SysSuite.Watchdog-ded220a8-4f69-4c83-a388-980c6bafc6dd</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <!-- T0.6 品牌资产：托盘复用主程序的多尺寸图标（嵌入为资源，避免运行时路径依赖） -->
  <ItemGroup>
    <EmbeddedResource Include="..\SysSuite.UI\Assets\App.ico" LogicalName="SysSuite.Watchdog.App.ico" />
  </ItemGroup>

  <PropertyGroup>
    <ApplicationIcon>..\SysSuite.UI\Assets\App.ico</ApplicationIcon>
  </PropertyGroup>
</Project>
